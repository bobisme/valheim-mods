1791857863716175	claude-jarldom	itc:AQ		item.link	bn-3c1	{"link_type":"blocks","target":"bn-3kt"}	blake3:q1K2HxqW5EwUihZSnBew9mOgBIuK8kdJzb3_nQkx9PY
1791857863725390	claude-jarldom	itc:AQ		item.create	bn-38ia	{"description":"# Context & Background\nSpec 2.3 #24.\n# Implementation Approach\nClient-side material tint on the villager body (skin colour shift toward the draugr palette; stage 2 darker + eye texture/colour). Drive from a tiny synced stage value (one byte; body key is acceptable at this size, or derive from soul ZDO) - measure with `jarldom netsize`.\n# Acceptance Criteria\n- [ ] Stage 1 and 2 visibly distinct; cleared on reset; no measurable network growth.\n# How This Serves Project Goals\nMakes the Dimming legible without UI.\n","kind":"task","labels":["jarldom","next-saga","j3","p2"],"parent":"bn-3k3","size":"m","title":"J3 #24b: The Dimming visuals - stage 1 draugr-like tint, stage 2 darker with sunken eyes"}	blake3:1LTLlR9PCH1fNvgBc_owzV6rCj36zSJ3zh5qLY8eaiw
