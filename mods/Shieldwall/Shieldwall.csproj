<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>Shieldwall</AssemblyName><RootNamespace>Shieldwall</RootNamespace></PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Models/warstone/warstone.json.gz" LogicalName="Shieldwall.warstone.json.gz" />
    <EmbeddedResource Include="Models/socket/socket.json.gz" LogicalName="Shieldwall.socket.json.gz" />
    <EmbeddedResource Include="Models/stave/stave_*.json.gz" LogicalName="Shieldwall.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.AIModule"><HintPath>$(ManagedDir)/UnityEngine.AIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
